# 이 파일을 복사해서 .env를 만들고 비밀번호를 바꾼다.
# .env는 .gitignore에 있어 커밋되지 않는다.
ORACLE_PASSWORD=ChangeMe_Sys1
APP_USER=settlement
APP_USER_PASSWORD=ChangeMe_App1

# 카드번호 보호 키 (ADR-0005). 32바이트 Base64: openssl rand -base64 32
CARD_ENCRYPTION_KEY=
CARD_HMAC_KEY=

# 로컬 가맹점 M000000001의 API 키. bootRun이 넣고 scripts/smoke-test.sh가 쓴다: openssl rand -hex 32
LOCAL_MERCHANT_API_KEY=
